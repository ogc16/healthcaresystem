# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Appwrite (server) ---
# Server-only. Used by node-appwrite with the API key below.
NEXT_PUBLIC_ENDPOINT="https://cloud.appwrite.io/v1"
PROJECT_ID=""
API_KEY=""
DATABASE_ID=""
PATIENT_COLLECTION_ID=""
DOCTOR_COLLECTION_ID=""
APPOINTMENT_COLLECTION_ID=""

# --- Appwrite (client) ---
NEXT_PUBLIC_BUCKET_ID=""

# --- Admin authentication ---
# Server-only. MUST NOT be prefixed with NEXT_PUBLIC_, otherwise Next.js inlines
# it into the client bundle and the passkey becomes public.
ADMIN_PASSKEY=""

# Server-only. Random 32+ char string used to HMAC-sign the admin session
# cookie. Rotating this invalidates all active admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Sentry (optional) ---
# Used by next.config.mjs for source-map upload. Defaults to carepulse /
# care-pulse. SENTRY_AUTH_TOKEN is only needed if you want source maps uploaded.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Build behaviour ---
# next build hangs waiting on Sentry network telemetry unless this is "false".
SENTRY_TELEMETRY=false