# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Appwrite (server) ---
# Server-only. Used by node-appwrite with the API key below.
NEXT_PUBLIC_ENDPOINT="https://cloud.appwrite.io/v1"
PROJECT_ID=""
API_KEY=""
DATABASE_ID=""
PATIENT_COLLECTION_ID=""
DOCTOR_COLLECTION_ID=""
APPOINTMENT_COLLECTION_ID=""
# Append-only audit trail of PHI access (created by scripts/setup-appwrite.mjs).
AUDIT_COLLECTION_ID=""
# Async SMS delivery queue; drained by /api/cron/sms (created by setup script).
SMS_OUTBOX_COLLECTION_ID=""
# Persistent background job queue (PDF invoices, reminder dispatch); drained by
# /api/cron/jobs (created by setup script).
JOB_QUEUE_COLLECTION_ID=""

# --- PHI encryption ---
# Server-only. 64 hex chars = 32 random bytes. AES-256-GCM key used to encrypt
# protected health information (medical history, national IDs, addresses) at
# rest in Appwrite. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes previously stored PHI unreadable, so treat it as a secret.
PHI_ENCRYPTION_KEY=""

# --- Appwrite (client) ---
NEXT_PUBLIC_BUCKET_ID=""

# --- Admin authentication ---
# Server-only. MUST NOT be prefixed with NEXT_PUBLIC_, otherwise Next.js inlines
# it into the client bundle and the passkey becomes public.
ADMIN_PASSKEY=""

# Server-only. Random 32+ char string used to HMAC-sign the admin session
# cookie. Rotating this invalidates all active admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Sentry (optional) ---
# Error reporting is OFF unless a DSN is set. Nothing is sent anywhere without
# these. Earlier versions of this app committed a DSN belonging to the upstream
# tutorial author, so every deployment reported to a third party by default.
#
# SENTRY_DSN is the server DSN. Never give it a NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_SENTRY_DSN is the browser DSN, inlined into the client bundle at
# build time. A Sentry DSN is a write-only ingest key rather than a credential,
# so exposing it is fine, but it must point at YOUR project.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Used by next.config.mjs for source-map upload. Defaults to carepulse /
# care-pulse. SENTRY_AUTH_TOKEN is only needed if you want source maps uploaded.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Build behaviour ---
# next build hangs waiting on Sentry network telemetry unless this is "false".
SENTRY_TELEMETRY=false

# --- SMS outbox delivery ---
# Maximum delivery attempts for a queued SMS before it is marked failed.
# Default 5. Applied with capped exponential backoff between retries.
# SMS_MAX_ATTEMPTS=5

# --- Job queue ---
# Maximum attempts for a drained job (already-queued invoices, reminders)
# before it is marked failed. Default 5. Capped exponential backoff.
# JOB_MAX_ATTEMPTS=5

# Secret that gates the /api/cron/sms drain endpoint. Leave unset to keep the
# drain disabled; set it and hit the endpoint with `x-cron-secret: <value>` on
# a schedule. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# --- AI patient-message triage (optional) ---
# Server-only. Keys the Gemini API used by /api/ai/triage to flag urgent
# patient messages for a clinician's attention. Leave unset to run the
# feature fully disabled: the triage endpoint degrades to a non-blocking
# "routine" verdict instead of failing callers.
GEMINI_API_KEY=""
# Model used for triage. Defaults to gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"